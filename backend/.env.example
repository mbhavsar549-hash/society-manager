# ---- Local development: nothing needed (SQLite, demo data). ----
# ---- Production (Render) ----
SECRET_KEY=put-a-long-random-string-here
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Your Netlify site address(es), comma separated, no trailing slash:
CORS_ORIGINS=https://your-site.netlify.app
# optional, to allow Netlify deploy previews too:
# CORS_ORIGIN_REGEX=https://.*--your-site\.netlify\.app
SEED=0                      # 1 = load demo data, 0 = start empty
ADMIN_EMAIL=you@example.com # first admin, created only when the database is empty
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Administrator
SCHEDULER_TZ=Asia/Kolkata
ESCALATE_AFTER_DAYS=7
